{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test:unit": "tsx --test \"app/**/*.test.ts\" \"lib/**/*.test.ts\" \"components/**/*.test.ts\" \"features/**/*.test.ts\" \"scripts/**/*.test.ts\" \"worker/**/*.test.ts\" \"prisma/**/*.test.ts\" \"test/**/*.test.ts\" \"e2e/devices/**/*.test.ts\" \"e2e/fixtures/**/*.test.ts\"",
    "test:int": "tsx --test \"**/*.int.test.ts\"",
    "test:devices": "playwright test -c playwright.devices.config.ts",
    "test:layout": "playwright test -c playwright.devices.config.ts layout/",
    "test:ui-gallery": "playwright test -c playwright.devices.config.ts ui/",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:openings": "tsx prisma/opening-seed.ts",
    "prisma:seed:content": "tsx prisma/seed-content.ts",
    "test:e2e": "set -a && source .env.test && set +a && npx playwright test 2>&1",
    "test:e2e:ui": "set -a && source .env.test && set +a && npx playwright test --ui 2>&1",
    "test:e2e:headed": "set -a && source .env.test && set +a && npx playwright test --headed 2>&1",
    "test:seo": "tsx scripts/seo-check.ts",
    "indexnow": "node scripts/indexnow.mjs",
    "dodo:setup-products": "tsx scripts/dodo-setup-products.ts",
    "media:upload": "tsx scripts/upload-media.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.7",
    "@dodopayments/nextjs": "^0.3.9",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.9",
    "@prisma/client": "^6.17.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@repo/analytics": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.38.0",
    "@tanstack/react-query": "5.104.5",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "dodopayments": "^2.49.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.5.9",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.442.0",
    "posthog-node": "5.56.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "standardwebhooks": "1.1.1",
    "stockfish": "^18.0.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@axe-core/playwright": "4.14.0",
    "@clerk/testing": "^1.13.37",
    "@playwright/test": "^1.58.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-query-devtools": "5.104.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.34.0",
    "prisma": "^6.17.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}
