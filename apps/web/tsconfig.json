{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-devices/types/**/*.ts",
    ".next-flagsoff/types/**/*.ts",
    ".next-gfinish/types/**/*.ts",
    ".next-int2/types/**/*.ts",
    ".next-prodcheck/types/**/*.ts",
    ".next-reg2/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "next.config.js",
    ".next-fixa/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
