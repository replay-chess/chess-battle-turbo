# Copy to apps/web/.env.local and fill in. Never commit .env.local.

# Database (Neon / PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Realtime
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3002
# Shared with apps/web-socket. Authenticates socket->web API calls and signs
# the WebSocket auth tokens issued by GET /api/socket-token.
INTERNAL_API_SECRET=

# Dodo Payments (billing)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Signing secret of the Dodo webhook pointed at /api/webhook/dodo-payments
DODO_PAYMENTS_WEBHOOK_KEY=
# Only the origin is used; checkout returns to an allowlisted app path on it.
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/pricing?checkout=success
# Player plan products. Create them with: pnpm --filter web dodo:setup-products
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_YEARLY=
# Original $8/month product, so existing subscribers stay recognized.
DODO_LEGACY_PLAYER_PRODUCT_ID=
# Paywall kill switch. "on" (default) requires an active Player plan to play;
# "off" lets every signed-in user play (use while configuring products, and in CI).
# Bypassed regardless for internal service calls, PERF_AUTH_BYPASS, and ADMIN users.
BILLING_PAYWALL=on

# Optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SCRAPER_API_KEY=
BLOG_PREVIEW_DRAFTS=false
