# Socket server environment (phase-02 plan 7.9). The server never loads a .env file: compose passes `env_file` on
# OCI; locally run it with an explicit environment, e.g. `(set -a; source .env.local-dev; set +a; pnpm dev)`.
# Never point a local run at production URLs or the production database.

# dev | production | test | local (required; the socket token `env` must match it)
APP_ENV=local
PORT=3002
# Exact origins allowed to open a socket (required for dev and production; the check fails closed).
ALLOWED_ORIGINS=http://localhost:3000
# User-token key ring "kid:base64[,kid:base64]" (≥ 32-byte keys, first signs). Same value as the web app's.
SOCKET_TOKEN_SECRET=
# Service HMAC key ring for /internal/* "kid:base64[,…]": web (Vercel → socket), ops (deploy CLI), wk (the analysis
# worker's emits and /internal/load, P3) and ws (the socket's own key: it signs the worker kick after a finish, P3).
# The ws and wk entries must equal the worker's ring entries of the same kid. The web's worker key `webwk` and ops'
# `opswk` belong to the web and the worker only.
INTERNAL_API_SECRET=
# Optional, only while v1 clients exist (v1 tokens and v1 x-internal-token calls; dev also accepts it for v2 tokens
# under kid s0 during the rollout). The web compares x-internal-token with ITS INTERNAL_API_SECRET verbatim, so if
# set it must equal the web's value exactly. Unset, the `web:<base64>` entry of INTERNAL_API_SECRET above is used as
# written, which matches a web holding that single entry (the normal case). Never set on production.
LEGACY_INTERNAL_API_SECRET=
# Protocol v1 handlers for clients without `proto: 2` (on until the parity gate).
PROTOCOL_V1=on
# Origin of the web app (PGN Site tag; P12 tournament calls). No NEXT_PUBLIC_ here.
WEB_APP_URL=http://localhost:3000
# The analysis worker (P3): the socket kicks it after every finish (signed with the ws key). Required with APP_ENV=dev
# (http://analysis-worker:3003 on the dev box, docker network only); unset on production until P13.
ANALYSIS_WORKER_URL=http://localhost:3003
# replay_realtime, pooled: ...?sslmode=require&pgbouncer=true&connection_limit=3&pool_timeout=10&connect_timeout=15
DATABASE_URL=
# The ndjson game journal (plan 7.6); the compose volume ws_journal on OCI. Unset = no journal (DB restore only).
JOURNAL_DIR=/data/journal
# Seconds between the deploy's restart notice and the restart (read by deploy-oci.yml from this file):
# 30 on dev, 120 on production.
DRAIN_NOTICE_SECONDS=30
# Tuning (defaults from plan 8.20): CHECKPOINT_PLIES=10 CHECKPOINT_MAX_AGE_MS=15000 GRACE_MS=30000
# FIRST_MOVE_MS=30000 REMATCH_MS=30000 RESUME_MAX_WAIT_MS=60000
# Test hook, APP_ENV=test only (the process exits at boot otherwise): TIMING_PROFILE=fast
# Behind Caddy on OCI: x-forwarded-for is trusted for the per-IP guard (default on for dev/production).
# TRUST_PROXY=on
LOG_LEVEL=info
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=
SENTRY_DSN=
