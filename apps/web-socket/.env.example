# WebSocket Server Configuration
PORT=3002
NODE_ENV=development

# Web App URL (for making API calls to the web app)
# The WebSocket server does NOT connect to the database directly
# Instead, it makes HTTP API calls to the web app, which handles all database operations
WEB_APP_URL=http://host.docker.internal:3000

# Shared secret for server-to-server API calls (must match apps/web/.env)
INTERNAL_API_SECRET=

# Socket authentication.
# Browsers send a short-lived token (signed with INTERNAL_API_SECRET by the web
# app's GET /api/socket-token) in the socket.io `auth` handshake. When this is
# "true", sockets without a valid token are rejected with "unauthorized" and a
# client can only join a game as the user its token names.
# Default: off (unset / anything other than "true"). Sockets without a token are
# then still admitted, only logged. Turn it on AFTER the web app that sends
# tokens is deployed, otherwise older clients cannot connect.
SOCKET_AUTH_REQUIRED=false
