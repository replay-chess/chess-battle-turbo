# Analysis worker environment (phase-03 plan §7.9). The worker never loads a .env file: compose passes `env_file` on
# the dev box (.env.worker, written by deploy-oci.yml from the GitHub secret WORKER_DEV_ENV_FILE); locally run it with
# an explicit environment, e.g. `(set -a; source .env.local-dev; set +a; pnpm --filter analysis-worker dev)`.
# Never point a local run at production URLs or the production database; the boot guards refuse most mistakes
# (config/env.ts), and the worker refuses the Neon owner role.

# dev | production | test | local (required). ENGINE=fake and WORKER_FAULT are refused unless test / dev,test.
APP_ENV=local
# The worker's own HTTP port (kick, metrics, health, ready). Never published on the host; Caddy proxies only the
# signed /internal/analysis/* and /internal/metrics to it.
PORT=3003
# Neon over HTTP (pooled host, *.neon.tech → @neondatabase/serverless), role replay_worker, never the owner role.
# APP_ENV=dev only accepts the dev branch's endpoint; a plain postgres:// to localhost uses `pg` (CI, Docker).
WORKER_DATABASE_URL=
# HMAC key ring "kid:base64[,kid:base64]" (≥ 32-byte keys): `wk` FIRST (the worker signs its emits and load probes
# with it), then every kid it accepts: webwk (Vercel's kick + metrics), ws (the socket's kick), opswk (the deploy
# smoke). Each entry must equal the same kid's entry in the web's and the socket's rings. Never the `web` or `ops`
# keys: the socket accepts those for every event and for drain, so the worker refuses to boot with them.
INTERNAL_API_SECRET=
# The socket server (docker network on the dev box): /internal/emit and /internal/load. Required for dev/production.
WS_INTERNAL_URL=http://localhost:3002
# lockedBy prefix (a boot id is appended). Unique per running worker: dev-worker on the dev box, dev-local locally.
WORKER_ID=local-worker
# stockfish (native binary) | fake (APP_ENV=test only)
ENGINE=stockfish
ENGINE_PATH=/usr/local/bin/stockfish
# The profile is code (sf18-v1, CA/src/version.ts): these must equal it or the worker refuses to boot.
ENGINE_PROFILE=sf18-v1
ENGINE_THREADS=1
ENGINE_HASH_MB=64
# Eval cache (E2 SQLite on the worker volume): on | off (off for goldens), its file, the R2 seed URL (downloaded once
# when the file is new), and the weekly trim size.
EVAL_CACHE=on
EVAL_CACHE_PATH=/data/evalcache/evals.sqlite
EVAL_CACHE_SEED_URL=
EVAL_CACHE_MAX_GB=4
# Pause between searches while the socket's event-loop lag p99 is above this (ms).
LAG_PAUSE_MS=40
# Test hook (APP_ENV dev/test only): fail_at_ply:<n> | stall_at_ply:<n> | engine_crash:<n> | hold_queue | pause_at:<phase>:<ms>
WORKER_FAULT=
# Telemetry (blank locally): Sentry project for the worker, the PostHog project key and host.
SENTRY_DSN=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
LOG_LEVEL=info

# ── P4 game import (phase-04 plan §7.9; every one optional, the default in the comment) ──────────────────────────────
# The provider base URLs are test hooks: unset = the real providers. With APP_ENV=production any other value is
# refused (the worker must never import from a mock in production). The e2e stack points them at the upstream mock.
CHESSCOM_API_BASE=
LICHESS_BASE_URL=
# The contact in the provider User-Agent (R-CC-03): ReplayChess/1.0 (+https://playchess.tech; <contact>)
UPSTREAM_CONTACT=hello@playchess.tech
# The import window and cap (D4-09), the analysis budget (§8.9) and the backlog spread.
IMPORT_WINDOW_MONTHS=12
IMPORT_MAX_GAMES=2000
IMPORT_ANALYSE_EAGER_TRIAL=20
IMPORT_ANALYSE_EAGER=50
IMPORT_ANALYSE_CAP=200
IMPORT_BACKLOG_SPREAD_DAYS=7
# Ops kill switch: on = the I/O lane claims no import (queued imports wait; nothing fails).
IMPORT_PAUSED=off
# off = every user counts as a member (the web's BILLING_PAYWALL switch; keep both equal).
BILLING_PAYWALL=on
# Test hook (dev/test/local only; the worker refuses to boot with it on and APP_ENV=production): the provider fault
# table behind /dev/import (POST /internal/dev/fault: synthetic 503 / 429 / timeout per provider, ≤ 600 s).
IMPORT_FAULTS_ALLOWED=off

# ── P5 Mistake Bank (phase-05 plan §7.6, §7.8; both optional, the default in the comment) ─────────────────────────────
# Kill switch: off = the analysis skips the Mistake Bank extraction (J1) and EXTRACT_MISTAKES rows wait in the queue
# (the analysis still completes; the backfill catches up once it is on again).
BANK_EXTRACT_ENABLED=on
# The node budget of one puzzle-line search (≤ 3 per puzzle candidate, MultiPV 2), 10000..5000000.
BANK_LINE_NODES=500000
