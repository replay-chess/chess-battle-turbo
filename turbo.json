{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DEBUG",
    "DODO_PAYMENTS_API_KEY",
    "DODO_PAYMENTS_ENVIRONMENT",
    "DODO_PAYMENTS_RETURN_URL",
    "DODO_PAYMENTS_WEBHOOK_KEY",
    "DODO_PRODUCT_ID_MONTHLY",
    "DODO_PRODUCT_ID_YEARLY",
    "DODO_LEGACY_PLAYER_PRODUCT_ID",
    "BILLING_PAYWALL",
    "PERF_AUTH_BYPASS",
    "INTERNAL_API_SECRET",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "TEST_REALTIME_DATABASE_URL",
    "TEST_APP_DATABASE_URL",
    "TEST_WORKER_DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SIGNING_SECRET",
    "CLAIMS_BACKFILL_CONFIRM",
    "CRON_SECRET",
    "RATE_LIMIT_IP_PEPPER",
    "PERF_TOKEN",
    "E2E_TEST_TOKEN",
    "E2E_CLEANUP_SECRET",
    "ALLOW_TEST_HOOKS",
    "ROUTE_VALIDATE_RESPONSES",
    "LEGACY_402_MIRROR",
    "AUTHZ_BASE_URL",
    "MIDDLEWARE_MEMBER_GATE",
    "EDGE_DOC_LIMIT",
    "FLAGS_OVERRIDE",
    "POSTHOG_FEATURE_FLAGS_KEY",
    "POSTHOG_PROJECT_KEY",
    "POSTHOG_HOST",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "NEXT_RUNTIME",
    "NEXT_DIST_DIR",
    "USE_STANDALONE",
    "BLOG_PREVIEW_DRAFTS",
    "SCRAPER_API_KEY",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TELEMETRY_SINK",
    "SOCKET_TOKEN_SECRET",
    "NEXT_PUBLIC_WEBSOCKET_URL",
    "NEXT_PUBLIC_ENGINE_BASE_URL",
    "APP_ENV",
    "PORT",
    "SENTRY_DSN",
    "WEB_APP_URL",
    "ALLOWED_ORIGINS",
    "LEGACY_INTERNAL_API_SECRET",
    "PROTOCOL_V1",
    "TIMING_PROFILE",
    "TRUST_PROXY",
    "LOG_LEVEL",
    "JOURNAL_DIR",
    "CHECKPOINT_PLIES",
    "CHECKPOINT_MAX_AGE_MS",
    "GRACE_MS",
    "FIRST_MOVE_MS",
    "REMATCH_MS",
    "RESUME_MAX_WAIT_MS",
    "DRAIN_NOTICE_SECONDS",
    "BACKFILL_ALLOWED_HOSTS",
    "DEV_DB_HOSTS",
    "ANALYSIS_WORKER_URL",
    "WORKER_DATABASE_URL",
    "WS_INTERNAL_URL",
    "WORKER_ID",
    "ENGINE",
    "ENGINE_PATH",
    "ENGINE_THREADS",
    "ENGINE_HASH_MB",
    "ENGINE_PROFILE",
    "EVAL_CACHE",
    "EVAL_CACHE_PATH",
    "EVAL_CACHE_SEED_URL",
    "EVAL_CACHE_MAX_GB",
    "LAG_PAUSE_MS",
    "WORKER_FAULT",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL",
    "LICHESS_CLIENT_ID",
    "LICHESS_BASE_URL",
    "CHESSCOM_API_BASE",
    "DODO_API_BASE_URL",
    "UPSTREAM_CONTACT",
    "SIGNED_COOKIE_SECRET",
    "HASH_PEPPER",
    "IMPORT_WINDOW_MONTHS",
    "IMPORT_MAX_GAMES",
    "IMPORT_ANALYSE_EAGER_TRIAL",
    "IMPORT_ANALYSE_EAGER",
    "IMPORT_ANALYSE_CAP",
    "IMPORT_BACKLOG_SPREAD_DAYS",
    "IMPORT_PAUSED",
    "IMPORT_FAULTS_ALLOWED",
    "MAINTENANCE_AFFECTS",
    "MAINTENANCE_RETRY_AT"
  ],
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^generate", "^check-types"]
    },
    "test": {
      "dependsOn": ["^generate"],
      "outputs": []
    },
    "test:int": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
