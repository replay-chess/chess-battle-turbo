{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DEBUG",
    "DODO_PAYMENTS_API_KEY",
    "DODO_PAYMENTS_ENVIRONMENT",
    "DODO_PAYMENTS_RETURN_URL",
    "DODO_PAYMENTS_WEBHOOK_KEY",
    "DODO_PRODUCT_ID_MONTHLY",
    "DODO_PRODUCT_ID_YEARLY",
    "DODO_LEGACY_PLAYER_PRODUCT_ID",
    "BILLING_PAYWALL",
    "PERF_AUTH_BYPASS",
    "INTERNAL_API_SECRET",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SIGNING_SECRET",
    "CLAIMS_BACKFILL_CONFIRM",
    "CRON_SECRET",
    "RATE_LIMIT_IP_PEPPER",
    "PERF_TOKEN",
    "E2E_TEST_TOKEN",
    "E2E_CLEANUP_SECRET",
    "ALLOW_TEST_HOOKS",
    "ROUTE_VALIDATE_RESPONSES",
    "LEGACY_402_MIRROR",
    "AUTHZ_BASE_URL",
    "MIDDLEWARE_MEMBER_GATE",
    "EDGE_DOC_LIMIT",
    "FLAGS_OVERRIDE",
    "POSTHOG_FEATURE_FLAGS_KEY",
    "POSTHOG_PROJECT_KEY",
    "POSTHOG_HOST",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "NEXT_RUNTIME",
    "NEXT_DIST_DIR",
    "USE_STANDALONE",
    "BLOG_PREVIEW_DRAFTS",
    "SCRAPER_API_KEY",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TELEMETRY_SINK"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
