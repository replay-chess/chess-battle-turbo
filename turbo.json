{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DEBUG",
    "DODO_PAYMENTS_API_KEY",
    "DODO_PAYMENTS_ENVIRONMENT",
    "DODO_PAYMENTS_RETURN_URL",
    "DODO_PAYMENTS_WEBHOOK_KEY",
    "DODO_PRODUCT_ID_MONTHLY",
    "DODO_PRODUCT_ID_YEARLY",
    "DODO_LEGACY_PLAYER_PRODUCT_ID",
    "BILLING_PAYWALL",
    "PERF_AUTH_BYPASS",
    "INTERNAL_API_SECRET",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "TEST_REALTIME_DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SIGNING_SECRET",
    "CLAIMS_BACKFILL_CONFIRM",
    "CRON_SECRET",
    "RATE_LIMIT_IP_PEPPER",
    "PERF_TOKEN",
    "E2E_TEST_TOKEN",
    "E2E_CLEANUP_SECRET",
    "ALLOW_TEST_HOOKS",
    "ROUTE_VALIDATE_RESPONSES",
    "LEGACY_402_MIRROR",
    "AUTHZ_BASE_URL",
    "MIDDLEWARE_MEMBER_GATE",
    "EDGE_DOC_LIMIT",
    "FLAGS_OVERRIDE",
    "POSTHOG_FEATURE_FLAGS_KEY",
    "POSTHOG_PROJECT_KEY",
    "POSTHOG_HOST",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "NEXT_RUNTIME",
    "NEXT_DIST_DIR",
    "USE_STANDALONE",
    "BLOG_PREVIEW_DRAFTS",
    "SCRAPER_API_KEY",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TELEMETRY_SINK",
    "SOCKET_TOKEN_SECRET",
    "NEXT_PUBLIC_WEBSOCKET_URL",
    "NEXT_PUBLIC_ENGINE_BASE_URL",
    "APP_ENV",
    "PORT",
    "SENTRY_DSN",
    "WEB_APP_URL",
    "ALLOWED_ORIGINS",
    "LEGACY_INTERNAL_API_SECRET",
    "PROTOCOL_V1",
    "TIMING_PROFILE",
    "TRUST_PROXY",
    "LOG_LEVEL",
    "JOURNAL_DIR",
    "CHECKPOINT_PLIES",
    "CHECKPOINT_MAX_AGE_MS",
    "GRACE_MS",
    "FIRST_MOVE_MS",
    "REMATCH_MS",
    "RESUME_MAX_WAIT_MS",
    "DRAIN_NOTICE_SECONDS",
    "BACKFILL_ALLOWED_HOSTS",
    "DEV_DB_HOSTS"
  ],
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^generate", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
