# Paste the filled-in contents of this file into the PROD_ENV_FILE GitHub
# secret. It is sourced by `sh` during the image build, so quote any value
# that contains spaces or shell characters (& ? $ ; etc.), e.g. KEY="a&b".
# Never commit the filled-in file.

# Neon: pooled URL (host has -pooler) and direct URL (no -pooler)
DATABASE_URL=
DIRECT_URL=

# Clerk (production instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Realtime. Generate the secret with: openssl rand -hex 32
NEXT_PUBLIC_WEBSOCKET_URL=wss://ws-chess.playchess.tech
INTERNAL_API_SECRET=
ALLOWED_ORIGINS=https://www.playchess.tech,https://playchess.tech
# Turn on once the new web app is live
SOCKET_AUTH_REQUIRED=false

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL="https://www.playchess.tech/pricing?checkout=success"
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_YEARLY=
DODO_LEGACY_PLAYER_PRODUCT_ID=
BILLING_PAYWALL=on

# Optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SCRAPER_API_KEY=
BLOG_PREVIEW_DRAFTS=false
