# Caddy gets and renews TLS certificates for these hosts automatically once
# their DNS A records point at the server. WebSocket upgrades are proxied
# without extra config.

www.playchess.tech, playchess.tech {
	encode zstd gzip
	# next.config.mjs redirects playchess.tech -> www
	reverse_proxy web:3000
}

ws-chess.playchess.tech {
	reverse_proxy websocket:3002
}
