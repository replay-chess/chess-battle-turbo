# Caddy gets and renews the TLS certificate automatically once the DNS A
# record points at the server. WebSocket upgrades are proxied without extra
# config. The web app (www.playchess.tech) is served by Vercel.

# WS_HOST comes from the stack's .env: ws-chess.playchess.tech on prod, the
# dev hostname on the dev server.
{$WS_HOST} {
	# Internal bodies are small (phase-02 plan 7.5.1); refuse anything larger before Node reads it.
	@internal path /internal/*
	request_body @internal {
		max_size 64KB
	}
	# The worker's kick body is ≤ 1 KB (phase-03 plan §7.5), as are the P4 lookup and dev-fault bodies (phase-04 plan
	# §7.7.3): 4 KB is the edge limit.
	@worker path /internal/analysis/* /internal/provider/* /internal/dev/*
	request_body @worker {
		max_size 4KB
	}

	# `route` keeps the order below exactly as written (Caddy would otherwise sort `handle` before `respond`).
	route {
		# The socket's ops endpoints and its load probe are reached only from inside the docker network
		# (docker compose exec websocket node dist/cli/internal.js …; the worker's lag pause), never from outside.
		@opsOnly path /internal/broadcast /internal/drain /internal/load
		respond @opsOnly 404

		# Unsigned pre-check (feasibility SEC-8): a request without the HMAC signature header never reaches Node on
		# the 1-OCPU box. The socket server and the worker still verify every signature (kid, ts, sig, replay).
		@unsigned {
			path /internal/* /engine/*
			not header X-Rc-Sig *
		}
		respond @unsigned 401

		# Reserved for P7's engine API: not served in phase 3.
		respond /engine/* 404

		# The analysis worker (compose profile `worker`, dev box only): the signed kick from Vercel and the socket, and
		# the signed in-memory metrics the web's daily cron backstop reads (worker-alive; the worker accepts only the
		# kids ws, webwk and opswk). The socket's own /internal/metrics stays docker-only (dist/cli/internal.js). The
		# worker's /health and /ready are not proxied.
		# This one file serves both boxes: the worker routes exist only where the stack runs the `worker` profile
		# (COMPOSE_PROFILES, substituted when Caddy loads this file). Elsewhere (production, no worker) they answer 404,
		# never a 502 from an upstream that is not there (FIX-2).
		#
		# P4 (phase-04 plan §7.7.3): the web's signed Chess.com lookup fallback (/internal/provider/*) goes to the worker
		# wherever the worker runs (the dev box now; production once P13 gives it a worker, with no edit here). The
		# provider fault table (/internal/dev/*, a test hook) is proxied only on the dev box (APP_ENV=dev in the stack's
		# .env): anywhere else it is a 404 at the edge, and the worker itself refuses to boot with the fault switch in
		# production.
		@toWorker {
			path /internal/analysis/* /internal/metrics /internal/provider/*
			expression `'{$COMPOSE_PROFILES:none}' == 'worker'`
		}
		reverse_proxy @toWorker analysis-worker:3003
		@toWorkerDev {
			path /internal/dev/*
			expression `'{$COMPOSE_PROFILES:none}' == 'worker' && '{$APP_ENV:none}' == 'dev'`
		}
		reverse_proxy @toWorkerDev analysis-worker:3003
		respond /internal/analysis/* 404
		respond /internal/metrics 404
		respond /internal/provider/* 404
		respond /internal/dev/* 404

		reverse_proxy websocket:3002
	}
}
