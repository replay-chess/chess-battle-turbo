# Caddy gets and renews the TLS certificate automatically once the DNS A
# record points at the server. WebSocket upgrades are proxied without extra
# config. The web app (www.playchess.tech) is served by Vercel.

# WS_HOST comes from the stack's .env: ws-chess.playchess.tech on prod, the
# dev hostname on the dev server.
{$WS_HOST} {
	reverse_proxy websocket:3002
}
