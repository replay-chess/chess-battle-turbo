# WebSocket server env for the OCI host. Paste the filled-in contents into the
# WS_ENV_FILE GitHub secret. Never commit the filled-in file.

# The Vercel-hosted web app the socket server calls for all DB operations
WEB_APP_URL=https://www.playchess.tech

# Must equal INTERNAL_API_SECRET in the Vercel project's env vars
INTERNAL_API_SECRET=

ALLOWED_ORIGINS=https://www.playchess.tech,https://playchess.tech
# Turn on once the web app that sends socket tokens is live
SOCKET_AUTH_REQUIRED=false

# Sentry project replay-chess-websocket (client keys page)
SENTRY_DSN=
# Sentry/telemetry environment tag: "production" on prod, "dev" on the dev server
APP_ENV=production

# ── The analysis worker (phase-03 plan §3.2, §7.9; dev box only until P13) ─────────────────────────────────────────
# The socket kicks the worker after every finish (http://analysis-worker:3003 on the docker network). Required with
# APP_ENV=dev; unset on production. Full socket env reference: apps/web-socket/.env.example.
ANALYSIS_WORKER_URL=
# deploy-oci.yml adds to the DEV bundle only: COMPOSE_PROFILES=worker and WORKER_IMAGE=<ghcr image:sha> in this .env,
# and the worker's own env file .env.worker from the GitHub secret WORKER_DEV_ENV_FILE (variables:
# apps/analysis-worker/.env.example). The production bundle has neither, so the worker never starts on prod.

