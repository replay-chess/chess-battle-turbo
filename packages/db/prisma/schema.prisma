generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  // x64 Vercel/CI + arm64 OCI alpine (the socket server image, phase-02 plan 6.2)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                BigInt           @id @default(autoincrement())
  referenceId       String           @unique @default(cuid())
  code              String           @unique
  googleId          String           @unique
  email             String           @unique
  name              String
  profilePictureUrl String?
  dateOfBirth       DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  onboarded         Boolean          @default(false)
  dodoCustomerId    String?          @unique
  role              Role             @default(USER)

  // Billing entitlement, synced from Dodo Payments by the webhook and the
  // subscription API. Read through lib/billing/entitlement.ts, never directly.
  plan                  String?
  planInterval          String?
  subscriptionId        String?   @unique
  subscriptionStatus    String?
  subscriptionProductId String?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  subscriptionUpdatedAt DateTime?
  // Free trial: one per person. Set from the first subscription webhook that
  // carries trial_period_days > 0. A non-null trialStartedAt means the trial
  // has been used, even if it was cancelled.
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  /// M1 (P1). Provider-side time of the snapshot last applied (Dodo webhook timestamp or the API object's own
  /// timestamp). The billing compare-and-set key. Never set from now().
  subscriptionSourceAt  DateTime?
  /// M1 (P1). Bumped by every write that changes the member's game list (P2 finish, P3 analysis and review
  /// completion, P4 import and purge). P3's archive ETag reads it from the viewer row.
  gamesVersion          Int       @default(0)
  chessComProfile     ChessComProfile?
  gamesAsCreator       Game[]             @relation("CreatorGames")
  gamesAsOpponent      Game[]             @relation("OpponentGames")
  gamesWon             Game[]             @relation("WinnerGames")
  stats                UserStats?
  matchmakingRequests  MatchmakingQueue[]
  tournamentsCreated          Tournament[]              @relation("TournamentCreator")
  tournamentParticipations    TournamentParticipant[]
  /// M2 (P2). Games by fixed colour (B2) and the per-user game index (B1).
  gamesAsWhite         Game[]             @relation("WhiteGames")
  gamesAsBlack         Game[]             @relation("BlackGames")
  gamePlayers          GamePlayer[]
  /// M3 (P3). Legend comparisons and public share links owned by this member.
  legendComparisons    LegendComparison[]
  shares               Share[]

  @@index([googleId])
  @@index([email])
  @@index([code])
  @@index([referenceId])
  @@index([dodoCustomerId])
  @@index([subscriptionStatus])
  @@map("users")
}

model Game {
  id                    BigInt        @id @default(autoincrement())
  referenceId           String        @unique @default(cuid())
  creatorId             BigInt
  opponentId            BigInt?
  status                GameStatus    @default(WAITING_FOR_OPPONENT)
  result                GameResult?
  winnerId              BigInt?
  chessPositionId       BigInt?
  openingId             BigInt?
  startingFen           String
  initialTimeSeconds    Int
  incrementSeconds      Int
  creatorTimeRemaining  Int
  opponentTimeRemaining Int
  lastMoveAt            DateTime?
  gameData              Json?
  expiresAt             DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tournamentId          BigInt?
  creator               User          @relation("CreatorGames", fields: [creatorId], references: [id], onDelete: Cascade)
  opponent              User?         @relation("OpponentGames", fields: [opponentId], references: [id], onDelete: Cascade)
  winner                User?         @relation("WinnerGames", fields: [winnerId], references: [id])
  opening               Opening?      @relation("OpeningGames", fields: [openingId], references: [id], onDelete: SetNull)
  tournament            Tournament?   @relation("TournamentGames", fields: [tournamentId], references: [id], onDelete: SetNull)

  // ── M2 (Phase 2): typed play columns (phase-02 plan 6.2). Expand-only: every column is nullable or defaulted.
  /// null only on legacy rows until scripts/backfill-play-columns.ts has run
  mode          GameMode?
  /// false until P9 (ratings)
  rated         Boolean        @default(false)
  /// from initial + 40 × increment (P2 §8.11); UNTIMED for untimed bot games
  timeClass     TimeClass?
  /// fixed at creation (B2); a null side is the bot, or a friend who has not joined yet
  whitePlayerId BigInt?
  blackPlayerId BigInt?
  /// BOT / LEGEND_BOT: 400..2200
  botElo        Int?           @db.SmallInt
  /// ply number of startingFen: 2·(fullmove−1) + (side = b ? 1 : 0)
  startPly      Int            @default(0) @db.SmallInt
  /// 30 when startingFen ≠ initial (owner Q1), decided at creation
  studySeconds  Int            @default(0) @db.SmallInt
  /// Space-separated UCI from startingFen (~5 B/ply). Source of truth for the move list (B3).
  moves         String         @default("") @db.Text
  /// Mover's remaining ms after each ply (increment included). Empty for untimed games.
  moveClocksMs  Int[]          @default([])
  /// Checkpoint guard: UPDATE … WHERE "plyCount" <= $n (B3)
  plyCount      Int            @default(0) @db.SmallInt
  /// position after the last persisted ply (replaces gameData.fen)
  fen           String?
  /// remaining ms at the last checkpoint (replaces creator/opponent seconds, play-a B9)
  whiteTimeMs   Int?
  blackTimeMs   Int?
  /// 'w' | 'b' | null; running since lastMoveAt
  clockRunning  String?        @db.Char(1)
  /// live rehydration (P2 §7.6)
  phase         LivePhase?
  /// study end or first-move deadline
  phaseEndsAt   DateTime?
  endMethod     GameEndMethod?
  /// named outcome because Game.winner is the legacy winner relation
  outcome       GameWinner?
  /// Built once at game end with %clk (B3); immutable afterwards. Never written for imports.
  pgn           String?        @db.Text
  rematchOfId   BigInt?
  // Display snapshot read by P3, P4, P10, P12 (consistency R-01). Filled at creation and join; the finish fills
  // any that are still NULL. Bots get the ladder label "Engine {botElo}" and no title.
  whiteName     String?        @db.VarChar(40)
  blackName     String?        @db.VarChar(40)
  whiteRating   Int?           @db.SmallInt
  blackRating   Int?           @db.SmallInt
  whiteTitle    String?        @db.VarChar(4)
  blackTitle    String?        @db.VarChar(4)
  /// P4 writes CHESSCOM/LICHESS rows; P2 writes REPLAY only
  source        GameSource     @default(REPLAY)
  externalId    String?        @db.VarChar(40)
  externalUrl   String?        @db.VarChar(120)
  /// GameMetaV1 (packages/db/src/json/game-meta.ts): header, prefix, position card, assists, rev, drawOffers, client
  meta          Json?

  whitePlayer   User?         @relation("WhiteGames", fields: [whitePlayerId], references: [id], onDelete: SetNull)
  blackPlayer   User?         @relation("BlackGames", fields: [blackPlayerId], references: [id], onDelete: SetNull)
  rematchOf     Game?         @relation("Rematches", fields: [rematchOfId], references: [id], onDelete: SetNull)
  rematches     Game[]        @relation("Rematches")
  players       GamePlayer[]

  // ── M3 (Phase 3): server analysis (phase-03 plan 6.2). Expand-only.
  /// NONE until the game is enqueued; SKIPPED for aborted games and games under 6 plies (no job)
  analysisStatus    AnalysisStatus     @default(NONE)
  /// opening of the game (deepest EPD match, written by the worker when null; R-01, CON 3.4). Not the same thing as
  /// the existing openingId, which means "started from this opening line" and is never written by the worker.
  ecoCode           String?            @db.VarChar(3)
  openingName       String?            @db.VarChar(80)
  analysis          GameAnalysis?
  legendComparisons LegendComparison[]
  shares            Share[]

  // P4 import upsert; REPLAY rows have externalId NULL and never collide
  @@unique([source, externalId], map: "games_source_externalId_key")
  // The restore list and the sweeps use the partial games_open_idx (raw SQL in M2, protected-indexes.txt), not an
  // index on lastMoveAt, so the ≈ 10 checkpoint UPDATEs per game stay HOT. The existing @@index([status]) becomes
  // redundant and is dropped in contract step C1 (owner confirmation).
  @@index([creatorId])
  @@index([opponentId])
  @@index([winnerId])
  @@index([status])
  @@index([expiresAt])
  @@index([referenceId])
  @@index([chessPositionId])
  @@index([openingId])
  @@index([tournamentId])
  @@map("games")
}

model UserStats {
  id                    BigInt    @id @default(autoincrement())
  referenceId           String    @unique @default(cuid())
  userId                BigInt    @unique
  totalGamesPlayed      Int       @default(0)
  gamesWon              Int       @default(0)
  gamesLost             Int       @default(0)
  gamesDrawn            Int       @default(0)
  currentWinStreak      Int       @default(0)
  longestWinStreak      Int       @default(0)
  averageGameDuration   Int?
  lastPlayedAt          DateTime?
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceId])
  @@map("user_stats")
}

model ChessComProfile {
  id               BigInt   @id @default(autoincrement())
  referenceId      String   @unique @default(cuid())
  userId           BigInt   @unique
  chessComHandle   String   @unique
  displayName      String?
  avatar           String?
  title            String?
  country          String?
  status           String?
  followers        Int?
  isStreamer       Boolean  @default(false)
  joined           DateTime?
  rapidRating      Int?
  rapidBestRating  Int?
  rapidWins        Int?
  rapidLosses      Int?
  rapidDraws       Int?
  blitzRating      Int?
  blitzBestRating  Int?
  blitzWins        Int?
  blitzLosses      Int?
  blitzDraws       Int?
  bulletRating     Int?
  bulletBestRating Int?
  bulletWins       Int?
  bulletLosses     Int?
  bulletDraws      Int?
  dailyRating      Int?
  dailyBestRating  Int?
  dailyWins        Int?
  dailyLosses      Int?
  dailyDraws       Int?
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chessComHandle])
  @@index([referenceId])
  @@map("chess_com_profiles")
}

model ChessPosition {
  id          BigInt @id @default(autoincrement())
  referenceId String @unique @default(cuid())

  // ===== REQUIRED FIELDS (Minimum data needed) =====
  fen        String @unique
  sideToMove String

  // ===== OPTIONAL CORE DATA =====
  pgn        String?
  moveNumber Int?

  // ===== PLAYER INFO (All nullable) =====
  whitePlayerName     String?
  blackPlayerName     String?
  whitePlayerMetadata Json?
  blackPlayerMetadata Json?
  whitePlayerId       BigInt? // FK to Legend if white player is a legend
  blackPlayerId       BigInt? // FK to Legend if black player is a legend

  // ===== GAME METADATA (All nullable) =====
  tournamentName String?
  eventDate      DateTime?
  gameMetadata   Json?

  // ===== POSITION INFO (Optional but recommended) =====
  positionType    String?
  positionContext Json?

  // ===== EXPLANATION (Grandmaster thought process) =====
  explanation          Json?     // Segments with visuals + narration
  explanationAudioUrl  String?   // URL to audio file (e.g., CDN/S3)

  // ===== SOURCE (Track where it came from) =====
  sourceType     String @default("manual")
  sourceMetadata Json?

  // ===== ENGAGEMENT & SYSTEM =====
  timesPlayed     Int      @default(0)
  popularityScore Float?
  featured        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  whiteLegend Legend? @relation("WhiteLegendGames", fields: [whitePlayerId], references: [id], onDelete: SetNull)
  blackLegend Legend? @relation("BlackLegendGames", fields: [blackPlayerId], references: [id], onDelete: SetNull)
  tournaments Tournament[]
  /// M3 (P3). POSITION shares from P9; REVIEW shares of legend games keep it for the card.
  shares      Share[]

  @@index([referenceId])
  @@index([sourceType])
  @@index([featured])
  @@index([isActive])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@map("chess_positions")
}

model Legend {
  id          BigInt @id @default(autoincrement())
  referenceId String @unique @default(cuid())

  // ===== BASIC INFORMATION =====
  name String @unique // Full name (e.g., "Magnus Carlsen")
  era  String // Chess era (e.g., "Modern Era", "Romantic Era")

  // ===== VISUAL & DISPLAY =====
  profilePhotoUrl String? // URL to profile image

  // ===== CHESS STATS =====
  peakRating  Int?    // Peak ELO rating
  nationality String? // Country code (e.g., "NOR", "USA")

  // ===== DESCRIPTIONS =====
  shortDescription String  @db.VarChar(500) // 1-2 sentences for cards
  playingStyle     String? // Description of their style

  // ===== ADDITIONAL INFO =====
  birthYear Int?
  deathYear Int? // Null if still alive

  // ===== METADATA AS JSON =====
  achievements Json? // Array of major titles/achievements
  famousGames  Json? // Array of notable games with FEN positions

  // ===== ADMIN & ANALYTICS =====
  isActive  Boolean @default(true) // Record is active in system
  isVisible Boolean @default(false) // Show/hide on UI

  // ===== TIMESTAMPS =====
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Games where this legend played
  gamesAsWhite ChessPosition[] @relation("WhiteLegendGames")
  gamesAsBlack ChessPosition[] @relation("BlackLegendGames")
  tournaments  Tournament[]

  @@index([name])
  @@index([isActive])
  @@map("legends")
}

model Opening {
  id          BigInt   @id @default(autoincrement())
  referenceId String   @unique @default(cuid())

  eco        String   // ECO code e.g. "A00", "C50"
  name       String   // Full name e.g. "Italian Game: Giuoco Piano"
  pgn        String   // PGN moves e.g. "1. e4 e5 2. Nf3 Nc6 3. Bc4 Bc5"
  fen        String   // FEN after PGN moves played out
  sideToMove String   // "white" or "black" — whose turn after PGN
  moveCount  Int      // Number of half-moves (plies)

  explanation         Json?
  explanationAudioUrl String?

  isActive    Boolean      @default(true)
  /// M3 (P3). The first four FEN fields of `fen` (the position after the line): transposition-safe opening-name
  /// lookup (deepest EPD match) and the book seed. Filled by DB/scripts/backfill/opening-epd.ts; partial index
  /// openings_epd_idx (raw SQL in M3).
  epd         String?      @db.VarChar(90)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  games       Game[]       @relation("OpeningGames")
  tournaments Tournament[]

  @@index([eco])
  @@index([name])
  @@unique([eco, name, pgn])
  @@index([isActive])
  @@map("openings")
}

enum GameStatus {
  WAITING_FOR_OPPONENT
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  /// M2a (P2). Its own migration, one release before any writer (data-model §11.1.6, feasibility §9).
  ABORTED
}

// ── M2 (Phase 2) enums. IMPORTED, OTHER and the non-REPLAY sources exist from M2 but are first written by P4, so
//    every enum value obeys the two-release rule.
enum GameMode {
  LEGEND_BOT
  BOT
  FRIEND
  ONLINE
  TOURNAMENT
  IMPORTED
}

enum GameSource {
  REPLAY
  CHESSCOM
  LICHESS
}

enum TimeClass {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
  DAILY
  UNTIMED
}

enum GameEndMethod {
  CHECKMATE
  RESIGNATION
  TIMEOUT
  TIMEOUT_VS_INSUFFICIENT
  STALEMATE
  THREEFOLD
  FIFTY_MOVE
  INSUFFICIENT_MATERIAL
  AGREEMENT
  ABANDONED
  ABORTED
  OTHER
}

/// NONE = aborted
enum GameWinner {
  WHITE
  BLACK
  DRAW
  NONE
}

enum LivePhase {
  WAITING
  STUDY
  FIRST_MOVE
  PLAYING
  ENDED
}

enum PlayerResult {
  WIN
  LOSS
  DRAW
  ABORTED
}

/// M2 (Phase 2, B1). One row per member side of a game; bots have no row. The per-user game index for Home, the
/// archive, profile and weakness (filled further by P3, P4, P9). Later phases add their own nullable columns.
model GamePlayer {
  gameId         BigInt
  userId         BigInt
  /// 'w' | 'b'
  color          String        @db.Char(1)
  mode           GameMode
  timeClass      TimeClass?
  rated          Boolean       @default(false)
  /// null while the game is live
  result         PlayerResult?
  /// null while live → "my live games" = WHERE "endedAt" IS NULL (wire DTOs may call it playedAt)
  endedAt        DateTime?
  /// no FK (history column, data-model §2.8)
  opponentUserId BigInt?
  /// display snapshot: member name, "Engine 1400", "" until a friend joins
  opponentName   String        @default("") @db.VarChar(40)
  opponentRating Int?          @db.SmallInt
  /// P2: the displayed rating at start (Chess.com-derived); P9 writes Glicko values
  ratingBefore   Int?          @db.SmallInt
  ratingAfter    Int?          @db.SmallInt
  ratingDelta    Int?          @db.SmallInt
  /// denormalised, no FK
  tournamentId   BigInt?
  source         GameSource    @default(REPLAY)
  // ── M3 (Phase 3): written by the analysis worker's final batch (phase-03 plan 6.2).
  accuracy       Float?        @db.Real
  /// archive note, e.g. "Missed Rxf5 · move 19" | "Clean game" (plan 8.7)
  headline       String?       @db.VarChar(80)
  momentsCount   Int           @default(0) @db.SmallInt
  /// 13 counters indexed by JudgementCode (this side only; [0] unused)
  counts         Int[]         @default([]) @db.SmallInt
  /// [opening, middlegame, endgame]; -1 = phase not reached
  phaseAccuracy  Float[]       @default([]) @db.Real
  /// copy of games.ecoCode for per-user opening stats (P4, P6 read it)
  ecoCode        String?       @db.VarChar(3)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  game           Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// M3 (P3). The review of this member side (1:1 through the unique (gameId, color)).
  review         PlayerReview?

  @@id([gameId, userId])
  @@unique([gameId, color])
  @@index([userId, endedAt(sort: Desc), gameId(sort: Desc)])
  @@map("game_players")
}

/// M2i (P2; P1 did not ship it). Header-key idempotency for create endpoints (api-design §2.8). Kept 24 h.
model IdempotencyKey {
  userId         BigInt
  key            String   @db.VarChar(36)
  route          String   @db.VarChar(64)
  /// sha256 hex of the canonical JSON body
  requestHash    String   @db.Char(64)
  /// 0 running, 1 done
  status         Int      @db.SmallInt
  responseStatus Int?     @db.SmallInt
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ══ M3 (Phase 3): server analysis and Game Review (phase-03 plan 6.1-6.2). ══════════════════════════════════════
// Every value of every enum below ships in M3 and is first written in M3's own release (enum rollback rule, plan
// 6.1). The partial indexes, the lz4 settings and review_progress_merge() are raw SQL in the migration; their index
// names are in prisma/protected-indexes.txt. Role grants live in packages/db/scripts/roles/*.sql, not here.

/// M3. Job kinds (R-05 ledger). P3 writes ANALYZE_GAME, LEGEND_COMPARE and HOUSEKEEPING; the rest are reserved for
/// P4/P6/P7/P10 so their phases need no ADD VALUE migration. No HOURLY_TICK (P3-D22).
enum JobKind {
  ANALYZE_GAME
  REVIEW_TEXT
  LEGEND_COMPARE
  IMPORT_SYNC
  IMPORT_PURGE
  RECOMPUTE_WEAKNESS
  EXPORT_BUILD
  ACCOUNT_PURGE
  DODO_CUSTOMER_SYNC
  HOUSEKEEPING
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// games."analysisStatus". SKIPPED = aborted or under 6 plies (never enqueued).
enum AnalysisStatus {
  NONE
  QUEUED
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum EvalSource {
  ENGINE
  LICHESS
  MIXED
}

/// The 12 move labels (B8). Per-ply judgements are stored as smallint codes (CA/src/codec.ts), never as this enum;
/// it exists for typed JSON validation and for P5's Mistake.judgement.
enum Judgement {
  BRILLIANT
  GREAT
  BEST
  EXCELLENT
  GOOD
  BOOK
  FORCED
  INTERESTING
  INACCURACY
  MISTAKE
  MISS
  BLUNDER
}

enum ComparisonStatus {
  FACTS_READY
  NARRATING
  READY
  FAILED
}

/// One public-link table (DM D17): REVIEW (/r/<code>) from P3, POSITION (/s/<code>) from P9.
enum ShareKind {
  POSITION
  REVIEW
}

/// M3. One queue for every background job on the OCI worker (SKIP LOCKED claim, push wake-up). DM §5.4 + heartbeatAt,
/// fairSeq (R-05.1) and lastKickAt (AP-09). Claim/reaper/prune use the partial indexes jobs_ready_idx,
/// jobs_running_idx and jobs_finished_idx (raw SQL). Enqueue only through packages/db/src/jobs.ts.
model Job {
  id          BigInt    @id @default(autoincrement())
  kind        JobKind
  status      JobStatus @default(QUEUED)
  /// JOB_PRIORITY.* only (P3-D7): 100 user waiting · 80 game just ended · 60/50/20/15 imports, batch, weakness · 10 backlog · 0 housekeeping
  priority    Int       @default(10) @db.SmallInt
  /// per-user ordinal inside a batch, so equal-priority jobs interleave users (ARCH §1.10.4); 0 for single enqueues
  fairSeq     Int       @default(0)
  /// "analyze:<gameId>", "legend:<gameId>:<userId>", "housekeeping:<yyyy-mm-dd>", "regrade-sweep:<yyyy-mm-dd>"
  dedupeKey   String?   @unique @db.VarChar(120)
  /// no FK (DM D5): survives the deletion it may be cleaning up after
  userId      BigInt?
  /// no FK
  gameId      BigInt?
  /// JobPayloadV1 per kind (CT/internal/jobs.ts); always carries `v`
  payload     Json      @default("{\"v\":1}")
  result      Json?
  runAt       DateTime  @default(now())
  attempts    Int       @default(0) @db.SmallInt
  maxAttempts Int       @default(4) @db.SmallInt
  /// "<env>-worker-<bootId>"
  lockedBy    String?   @db.VarChar(40)
  lockedAt    DateTime?
  /// refreshed by every checkpoint and at least every 30 s while RUNNING (stale detection: plan 8.12)
  heartbeatAt DateTime?
  /// last web-side re-kick (CAS, at most one per 30 s per job; AP-09)
  lastKickAt  DateTime?
  /// "<code>: <short message>"; never PII
  lastError   String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@map("jobs")
}

/// M3. Packed engine facts for BOTH colours, one row per game (DM D3). Array index i = ply offset from Game.startPly.
/// Checkpointed every 10 plies while RUNNING (P3-D6); completedAt is set once at the end.
model GameAnalysis {
  gameId        BigInt     @id
  /// GRADING_VERSION (classifier); re-grade from stored evals when it changes (engine-free, P3-D28)
  version       Int        @db.SmallInt
  /// "sf18-armv8dp-<net8>/sf18-v1" (engine build id + profile)
  engine        String     @db.VarChar(48)
  nodesPass1    Int
  nodesPass2    Int
  evalSource    EvalSource @default(ENGINE)
  totalPlies    Int        @db.SmallInt
  gradedPlies   Int        @db.SmallInt
  failedAtPly   Int?       @db.SmallInt
  /// length gradedPlies+1 while running, totalPlies+1 when done. White POV; cp clamped ±9999; mate in n = sign·(30000 − n)
  evals         Int[]      @db.SmallInt
  /// MultiPV-2 score per position, same encoding; 32767 = no second legal move (P3-D28)
  second        Int[]      @db.SmallInt
  /// MoveCode per ply = from + 64·to + 4096·promo (promo 0 none, 1 n, 2 b, 3 r, 4 q); 0 = unknown/forced
  best          Int[]      @db.SmallInt
  /// JudgementCode per ply (0 = ungraded)
  judgements    Int[]      @db.SmallInt
  /// LinesV1, flagged plies only: {"<ply>": {"pv": "<uci …>", "alts": ["<uci>", …], "d": <winLoss×10>}} (lz4)
  lines         Json?
  middlegamePly Int?       @db.SmallInt
  endgamePly    Int?       @db.SmallInt
  accuracyWhite Float?     @db.Real
  accuracyBlack Float?     @db.Real
  /// 13 counters each (index = JudgementCode; [0] unused)
  countsWhite   Int[]      @db.SmallInt
  countsBlack   Int[]      @db.SmallInt
  /// median search depth reached in pass 1 (How we grade "about N plies deep")
  depthP50      Int?       @db.SmallInt
  /// games.completedAt → analysis:done emit, ms (server-side SLO truth, AP-15); null for regrades and backfills
  readyMs       Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?
  game          Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("game_analyses")
}

/// M3. Text + key moments + walkthrough state for one MEMBER side (DM D4). 1:1 with GamePlayer via its unique
/// (gameId, color). Key moments live in content.moments (≤ 3, P3-D3): there is no key_moments table.
model PlayerReview {
  gameId        BigInt
  /// 'w' | 'b'
  color         String     @db.Char(1)
  /// ReviewContentV1 (packages/db/src/json/review.ts). P3 writes source "template". (lz4)
  content       Json?
  /// PENDING | TEMPLATE | READY | FALLBACK (P3-D16)
  textStatus    String     @default("PENDING") @db.VarChar(10)
  /// P7
  model         String?    @db.VarChar(40)
  /// P7
  promptVersion Int?       @db.SmallInt
  /// ReviewProgressV1 (packages/db/src/json/review.ts). Written by A5/A6 only (a different writer than content),
  /// A5 through the SQL function review_progress_merge() (raw SQL in M3).
  progress      Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  gamePlayer    GamePlayer @relation(fields: [gameId, color], references: [gameId, color], onDelete: Cascade)

  @@id([gameId, color])
  @@map("player_reviews")
}

/// M3 (pulled forward from DM "M8", P3-D5). Legend comparison per (game, member).
model LegendComparison {
  gameId          BigInt
  userId          BigInt
  /// no FK: the legend position the game started from (copied from games.chessPositionId)
  chessPositionId BigInt?
  status          ComparisonStatus @default(FACTS_READY)
  /// ComparisonFactsV1 (packages/db/src/json/legend.ts)
  facts           Json
  /// NarrationV1, P7/P8 (personalised narration); null in P3
  narration       Json?
  model           String?          @db.VarChar(40)
  costMicroUsd    Int?
  /// LEGEND_COMPARE runs requested through A9b; capped at 3 (then 410)
  attempts        Int              @default(0) @db.SmallInt
  error           String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  game            Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gameId, userId])
  @@index([userId])
  @@map("legend_comparisons")
}

/// M3 (P3-D4). One public-link table: REVIEW (/r/<code>) now, POSITION (/s/<code>) from P9. DM D17: no view counters.
/// Partial indexes shares_owner_idx, shares_expires_idx and shares_game_idx are raw SQL in M3.
model Share {
  id              BigInt         @id @default(autoincrement())
  /// 8 chars of Crockford base32, lowercase (e.g. "8kq2xh4m"); 40 random bits from crypto.randomBytes
  code            String         @unique @db.VarChar(10)
  kind            ShareKind
  /// SetNull for POSITION; REVIEW shares are deleted explicitly by the account-deletion flow (P10)
  ownerId         BigInt?
  fen             String?
  chessPositionId BigInt?
  gameId          BigInt?
  ply             Int?           @db.SmallInt
  /// 'w' | 'b'
  color           String?        @db.Char(1)
  title           String?        @db.VarChar(80)
  subtitle        String?        @db.VarChar(40)
  note            String?        @db.VarChar(140)
  themes          String[]       @default([])
  showUsername    Boolean        @default(true)
  /// ShareSnapshotV1 (packages/db/src/json/share.ts): the frozen public payload (lz4)
  snapshot        Json?
  imageVersion    Int            @default(1) @db.SmallInt
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  owner           User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  game            Game?          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  chessPosition   ChessPosition? @relation(fields: [chessPositionId], references: [id], onDelete: SetNull)

  @@map("shares")
}

enum GameResult {
  CREATOR_WON
  OPPONENT_WON
  DRAW
  CREATOR_TIMEOUT
  OPPONENT_TIMEOUT
}

enum MatchmakingStatus {
  SEARCHING
  MATCHED
  CANCELLED
  EXPIRED
}

model MatchmakingQueue {
  id          BigInt @id @default(autoincrement())
  referenceId String @unique @default(cuid())

  // Player info
  userId          BigInt
  rating          Int?   // Player's rating for this time control (from ChessComProfile)
  timeControlType String // "bullet", "blitz", "rapid", "daily"

  // Game preferences
  legendReferenceId  String? // Legend.referenceId (no FK - just stored for position lookup)
  openingReferenceId String? // Opening.referenceId (no FK - just stored for position lookup)
  timeControlSeconds Int     // e.g., 300 for 5 min
  incrementSeconds   Int     // e.g., 5

  // Queue state
  status MatchmakingStatus @default(SEARCHING)

  // Timing
  createdAt DateTime  @default(now())
  expiresAt DateTime  // createdAt + 60 seconds
  matchedAt DateTime?

  // If matched, store game reference ID (no FK - just for returning to client)
  matchedGameRef String? // Game.referenceId when matched

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, timeControlSeconds, incrementSeconds, rating])
  @@index([expiresAt])
  @@map("matchmaking_queue")
}

// ===== TOURNAMENT SYSTEM =====

enum TournamentStatus {
  LOBBY
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TournamentMode {
  OPENING
  LEGEND
  ENDGAME
  FREE
}

model Tournament {
  id                  BigInt            @id @default(autoincrement())
  referenceId         String            @unique @default(cuid())
  name                String
  description         String            @default("")
  mode                TournamentMode
  status              TournamentStatus  @default(LOBBY)
  maxParticipants     Int?
  initialTimeSeconds  Int
  incrementSeconds    Int
  durationMinutes     Int
  openingId           BigInt?
  legendId            BigInt?
  chessPositionId     BigInt?
  createdByUserId     BigInt
  scheduledStartAt    DateTime @default(now())
  startedAt           DateTime?
  endsAt              DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  createdBy       User                    @relation("TournamentCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  opening         Opening?                @relation(fields: [openingId], references: [id], onDelete: SetNull)
  legend          Legend?                  @relation(fields: [legendId], references: [id], onDelete: SetNull)
  chessPosition   ChessPosition?          @relation(fields: [chessPositionId], references: [id], onDelete: SetNull)
  participants    TournamentParticipant[]
  games           Game[]                  @relation("TournamentGames")

  @@index([referenceId])
  @@index([status])
  @@index([createdByUserId])
  @@map("tournaments")
}

model TournamentParticipant {
  id             BigInt    @id @default(autoincrement())
  referenceId    String    @unique @default(cuid())
  tournamentId   BigInt
  userId         BigInt
  points         Decimal   @default(0) @db.Decimal(5, 1)
  wins           Int       @default(0)
  losses         Int       @default(0)
  draws          Int       @default(0)
  gamesPlayed    Int       @default(0)
  isSearching    Boolean   @default(false)
  searchingSince DateTime?
  joinedAt       DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, points(sort: Desc)])
  @@index([userId])
  @@map("tournament_participants")
}

/// M1 (P1). Webhook idempotency for Dodo and Clerk. Clerk rows never store the payload (PII).
/// Dodo payloads are kept 180 days, Clerk rows 30 days, then deleted by the daily cron (webhook-retention).
model WebhookEvent {
  provider    String    @db.VarChar(16) // "dodo" | "clerk"
  eventId     String    @db.VarChar(100) // Dodo `webhook-id`, Clerk `svix-id`
  type        String    @db.VarChar(64) // "subscription.active", "user.created", …
  eventTime   DateTime? // provider timestamp
  userId      BigInt? // users.id once resolved; no FK (rows outlive deleted users)
  status      String?   @db.VarChar(16) // "applied" | "ignored" | "stale" | "unmatched" | "error"
  error       String?   @db.VarChar(500) // safe message, never a stack
  payload     Json? // Dodo only
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@id([provider, eventId])
  @@map("webhook_events")
}

/// M1 (P1). Fixed-window counters for BURST limits only (window ≤ 300 s). Created UNLOGGED by hand in the
/// migration SQL: no WAL; Neon empties it when the compute restarts or scales to zero. A window ≤ 300 s cannot be
/// reset early by a suspend, because Neon suspends only after 300 s without queries.
/// Never store daily or monthly budgets here (use RateLimitWindow or count the source rows).
/// Never recreate this table with `prisma db push`: it would come back LOGGED.
model RateLimitBucket {
  key     String   @id @db.VarChar(120) // "rl:<bucket>:c:<clerkUserId>" | "rl:<bucket>:ip:<sha256(pepper‖ip)[0:16]>"
  count   Int
  resetAt DateTime

  @@map("rate_limit_buckets")
}

/// M1 (P1). The same counters for DURABLE limits (window > 300 s). Logged, so they survive a compute restart.
/// Same statement as the burst store; swept daily (rate-limit-sweep).
model RateLimitWindow {
  key     String   @id @db.VarChar(120)
  count   Int
  resetAt DateTime

  @@map("rate_limit_windows")
}
